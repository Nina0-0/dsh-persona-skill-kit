{
  "name": "dsh-skill-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Sidebar skill catalog for the DSH Web GUI: live catalog, fuzzy search, one-click copy, hover descriptions",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nina0-0/dsh-persona-skill-kit.git",
    "directory": "plugins/skill-menu"
  },
  "homepage": "https://github.com/Nina0-0/dsh-persona-skill-kit#readme",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
